{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obsidian-r2-viewer",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-16",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "r2_buckets": [
    { "binding": "VAULT", "bucket_name": "obsidian-vault-content" }
  ],
  "vars": {
    "GITHUB_OWNER": "replace-me",
    "GITHUB_REPO": "replace-me",
    "GITHUB_BRANCH": "main",
    "PUBLIC_PREFIX": ""
  }
}
