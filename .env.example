PORT=8787
# Cloudflare Tunnel経由で公開する全ページに必要なBasic認証情報
BASIC_AUTH_USER=change-me
BASIC_AUTH_PASSWORD=use-a-long-random-password
# SSHまたはHTTPS認証済みのprivateリポジトリURL
VAULT_REPOSITORY_URL=git@github.com:owner/private-vault.git
VAULT_BRANCH=main
# 作業ツリー。絶対パスを指定する。
VAULT_DIRECTORY=/var/lib/obsidian-vault
# 公開対象を絞る場合のみ指定する。例: notes
PUBLIC_PREFIX=
